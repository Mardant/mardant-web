INSERT OR IGNORE INTO catalog_public_v2(source_rowid,id_lote,lote_num,anime,precio_num,is_preventa,has_rank,search_text) SELECT p.rowid,p.id_lote,p.lote_num,COALESCE(p.anime,''),p.precio_num,CASE WHEN LOWER(COALESCE(p.etiqueta,''))='preventa' OR LOWER(COALESCE(p.busqueda,'')) LIKE '%amazon%' THEN 1 ELSE 0 END,CASE WHEN TRIM(COALESCE(p.rank,''))<>'' THEN 1 ELSE 0 END,LOWER(COALESCE(p.id_lote,'')) || char(31) || LOWER(COALESCE(p.etiqueta,'')) || char(31) || LOWER(COALESCE(p.anime,'')) || char(31) || LOWER(COALESCE(p.tipo,'')) || char(31) || LOWER(COALESCE(p.busqueda,'')) FROM productos_japon p WHERE p.rowid>? AND p.rowid<=? AND p.activo=1 AND UPPER(COALESCE(p.visible,'SI'))='SI' ORDER BY p.rowid;